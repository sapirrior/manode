  "homepage": "https://github.com/sapirrior/manode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/sapirrior/manode.git"
  },
  "bugs": {
    "url": "https://github.com/sapirrior/manode/issues"
  },
