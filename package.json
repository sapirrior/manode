{
  "name": "manode-docs",
  "version": "0.1.0",
  "description": "mandoc for Node.js - A terminal-based manual pager for viewing Node.js API documentation locally.",
  "preferGlobal": true,
  "bin": {
    "manode": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "sync": "node ./scripts/sync-docs.js"
  },
  "keywords": [
    "node",
    "node.js",
    "api",
    "documentation",
    "cli",
    "man",
    "mandoc",
    "pager",
    "terminal",
    "offline",
    "ink",
    "react"
  ],
  "author": "manode",
  "license": "MIT",
  "homepage": "https://github.com/sapirrior/manode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/sapirrior/manode.git"
  },
  "bugs": {
    "url": "https://github.com/sapirrior/manode/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "dependencies": {
    "ink": "^7.0.1",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "typescript": "^5.7.3"
  }
}
